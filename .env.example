# Copy this file to .env and replace the placeholders with your own keys.
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model used for query expansion and answers (optional, this is the default)
GROQ_MODEL=openai/gpt-oss-120b
# Get a Cohere key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
